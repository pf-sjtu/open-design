# Copy to .env and adjust. Real environment variables override this file.

# ── tools-pack root ───────────────────────────────────────────────
# Build output, runtime state, and the installed app all live here:
#   <root>/runtime/<platform>/namespaces/<namespace>/install/Open Design
# Relative values resolve against the repository root.
# Unset falls back to .tmp/tools-pack.
OD_TOOLS_PACK_DIR=../installed

# ── local dependencies (used instead of downloading; a set path that does
#    not exist is a hard error, so a typo can never silently download) ──
# An extracted Electron distribution (must contain electron.exe).
# Unset lets electron-builder download Electron itself.
OD_ELECTRON_DIST=

# ffmpeg. npm ships no win32-arm64 build; an arm64 binary from the host is best.
# Unset falls back to PATH.
OD_FFMPEG_BIN=

# better-sqlite3 is deliberately not listed: @electron/rebuild builds it for the
# target Electron ABI.

# ── packaging shape ───────────────────────────────────────────────
# Bundle Vela's OpenCode companion (~170 MB). Off by default: AMR resolves an
# OpenCode at run time from PATH, so a host install keeps AMR available.
OD_TOOLS_PACK_WITH_AGENT_RUNTIME=0
